# 统一换行符为 LF，避免 Windows 上 CRLF/LF 转换警告
* text=auto eol=lf

# 明确文本文件类型
*.md       text eol=lf
*.vue      text eol=lf
*.ts       text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# 二进制文件不做换行符转换
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.svg      binary
*.woff     binary
*.woff2    binary
